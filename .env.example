# Server-side only — never use VITE_ prefix for secrets (Vite embeds those in the client bundle).
OPENAI_API_KEY=sk-your-openai-api-key-here

# Monthly AI spend cap in USD (default: 10)
AI_MONTHLY_COST_LIMIT_USD=10

# Optional comma-separated allowed browser origins for AI functions CORS
# ALLOWED_ORIGINS=https://your-site.netlify.app
