# Server-side only — never use VITE_ prefix for secrets (Vite embeds those in the client bundle).
OPENAI_API_KEY=

# Monthly AI spend cap in USD (default: 10)
AI_MONTHLY_COST_LIMIT_USD=10

# AI stays off until all controls below and Netlify Blobs are configured.
AI_ENABLED=false
# Generate at least 32 random bytes; rotating this invalidates all guest sessions.
AI_SESSION_SECRET=
TURNSTILE_SECRET_KEY=
# Public widget key; exposed only by the readiness response.
TURNSTILE_SITE_KEY=
# Exact HTTPS origins. Localhost is enabled only under Netlify Dev.
ALLOWED_ORIGINS=https://your-site.netlify.app
# Netlify Blobs is required. There is no in-memory accounting fallback.
